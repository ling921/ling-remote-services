<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Ling.RemoteServices.Client</PackageId>
    <Title>Ling.RemoteServices Client</Title>
    <Description>Type-safe generated HttpClient proxies, URL formatting, serialization, streaming, and remote error handling for Ling.RemoteServices contracts.</Description>
    <PackageTags>remote-services;rpc;httpclient;blazor;webassembly;source-generator</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ling.RemoteServices\Ling.RemoteServices.csproj" />
    <ProjectReference Include="..\Ling.RemoteServices.Generators.Client\Ling.RemoteServices.Generators.Client.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\Ling.RemoteServices.Generators.Client\bin\$(Configuration)\netstandard2.0\Ling.RemoteServices.Generators.Client.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- Package Content -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="README.zh-CN.md" Pack="true" PackagePath="" />
    <None Include="..\..\assets\icon.png" Visible="false" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
