    <ProjectReference Include="..\..\src\Ling.RemoteServices.Client\Ling.RemoteServices.Client.csproj" />
    <ProjectReference Include="..\..\src\Ling.RemoteServices.Generators.Client\Ling.RemoteServices.Generators.Client.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
